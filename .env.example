# Copy this file to .env and fill in real values before running the server.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DATABASE_URL empty to use SQLite (good for development / a single shop).
# For Postgres later: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Used for invoices sent by email (Settings > System Configuration > Email).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=care@example.com

# WhatsApp Cloud API (Meta) — for sending invoices on WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
